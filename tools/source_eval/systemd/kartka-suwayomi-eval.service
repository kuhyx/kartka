[Unit]
Description=Kartka source evaluator: its own Suwayomi (127.0.0.1:4590, never the live :4567)
# Started only as a dependency of the evaluator jobs and stopped after them:
# the evaluator installs every candidate extension (~570) into THIS root.
StopWhenUnneeded=yes

[Service]
UnsetEnvironment=DISPLAY XAUTHORITY WAYLAND_DISPLAY
# Upstream's suwayomi-server.sh preloads this (it catches KCEF aborts).
Environment=LD_PRELOAD=%h/services/suwayomi/app/current/bin/catch_abort.so
# Same pinned release the live deploy installed (deploy/suwayomi/install.sh);
# separate rootDir, port and extension set.
# ParallelGC: a batch job wants throughput, not low pauses, and it has no
# concurrent-marking overhead like G1 (the default once the JVM sees >1 CPU;
# with the old 100 % quota it most likely saw one CPU and ran SerialGC). A
# full GC at 3 GB should take 1-2 s with 3 GC threads, well under the 20 s
# request timeout.
# ActiveProcessorCount pins the JVM to the 3-core quota, so GC/JIT pools are
# not sized for the 24 host cores and then throttled. gc.log (one line per
# collection) is the evidence for or against this choice.
ExecStart=%h/services/suwayomi/app/current/jre/bin/java \
	-Xmx3g \
	-XX:ActiveProcessorCount=3 \
	-XX:+UseParallelGC \
	-Xlog:gc:file=%h/.local/share/kartka-source-eval/gc.log:uptime,level:filecount=3,filesize=5m \
	-Djava.awt.headless=true \
	-Dsuwayomi.tachidesk.config.server.rootDir=%h/.local/share/kartka-source-eval/suwayomi \
	-Dsuwayomi.tachidesk.config.server.ip=127.0.0.1 \
	-Dsuwayomi.tachidesk.config.server.port=4590 \
	-Dsuwayomi.tachidesk.config.server.authMode=NONE \
	-Dsuwayomi.tachidesk.config.server.webUIEnabled=false \
	-Dsuwayomi.tachidesk.config.server.initialOpenInBrowserEnabled=false \
	-Dsuwayomi.tachidesk.config.server.systemTrayEnabled=false \
	-Dsuwayomi.tachidesk.config.server.kcefEnabled=false \
	-jar %h/services/suwayomi/app/current/bin/Suwayomi-Server.jar
# The JVM exits 143 on SIGTERM; that is a clean stop, not a failure.
SuccessExitStatus=143
Nice=19
IOSchedulingClass=idle
# Unnoticeable next to a game (kuhy 2026-11-12): SCHED_IDLE runs only on CPU
# time nothing else wants, and the affinity keeps it off the 7900X3D V-cache
# CCD (CPUs 0-5,12-17) that games use. CPUAffinity, not AllowedCPUs: the user
# manager has no cpuset controller delegated, so AllowedCPUs would be ignored.
CPUSchedulingPolicy=idle
CPUAffinity=6-11 18-23
# Measured 2026-10-25 (sample 200, 128 lanes): 1 core and 3 GB were the limit,
# 8.4 req/s at 64 in flight (about 120 ms of server CPU per request). 3 cores
# and a 3 GB heap (+~0.9 GB metaspace, code cache, thread stacks) lift both.
MemoryMax=4G
CPUQuota=300%
NoNewPrivileges=true
PrivateTmp=true
